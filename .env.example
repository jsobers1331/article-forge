# Only needed if using scripts/generate_article.py or scripts/call_llm.py's
# direct-call mode. scripts/generate_prompt.py alone needs none of these —
# it only produces a plain-text prompt you can paste into any LLM by hand.

DEEPSEEK_API_KEY=
SERPER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Needed only for scripts/collect_search_console.py (see DISCOVERY.md).
# GSC_CLIENT_ID/SECRET come from a "Desktop app" OAuth client you create once
# in Google Cloud Console. GSC_REFRESH_TOKEN is written automatically the
# first time you run `python scripts/collect_search_console.py --authorize`
# — never fill it in by hand.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Google Ads Keyword Planner API (requires a developer token and OAuth access)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
